{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projego",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "keep_vars": true,
  "assets": {
    "directory": "./extracted",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
